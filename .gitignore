# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Virtual environment
.venv/
venv/
env/

# Django
*.log
*.pot
db.sqlite3
Backend/db.sqlite3
Backend/.env
.env

# Django media uploads
media/
Backend/media/

# Django collected static (if using collectstatic)
staticfiles/

# ML model weights and large binaries (ignore trained weights anywhere in the repo)
*.pt
*.pth
*.h5
*.ckpt
*.onnx
*.safetensors
ml/__pycache__/

# Dataset
Data/

# Processed ML data (large, regenerable from the raw datasets)
*.npy
ml/**/processed/

# Documentation generated files (keep source, ignore builds)
documentation/*.pdf
documentation/__pycache__/

# VS Code
.vscode/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Jupyter (track .ipynb notebooks; ignore only the autosave checkpoint cache)
.ipynb_checkpoints/

# Migrations cache
**/migrations/__pycache__/
**/__pycache__/

# Coverage / test artifacts
.coverage
htmlcov/
.pytest_cache/

# Build artifacts
dist/
build/
*.egg-info/
